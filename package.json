{
  "name": "fart-raft",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "server": "node server/main.ts",
    "build": "vp build",
    "preview": "vp preview",
    "typecheck": "tsc && tsc -p tsconfig.sim.json && tsc -p server",
    "test": "vp test run",
    "check": "vp check && tsc -p tsconfig.sim.json && tsc -p scripts && tsc -p server && vp test run",
    "prepare": "vp config",
    "fmt": "vp fmt",
    "course": "node scripts/canyon.ts",
    "blender": "open -a Blender --args \"$PWD/assets-src/fart-raft.blend\" --python \"$PWD/assets-src/start_mcp.py\"",
    "kit": "/Applications/Blender.app/Contents/MacOS/Blender -b assets-src/fart-raft.blend --python assets-src/build_kit.py --python assets-src/export_kit.py"
  },
  "dependencies": {
    "@dimforge/rapier2d-compat": "^0.21.0",
    "@effect/platform-node": "4.0.5",
    "effect": "4.0.5",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/three": "^0.186.0",
    "typescript": "~6.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
